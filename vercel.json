{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/presets.php",
      "destination": "/api/presets"
    },
    {
      "source": "/api/boards.php",
      "destination": "/api/boards"
    }
  ],
  "headers": [
    {
      "source": "/(css|resources|js/vendor)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
